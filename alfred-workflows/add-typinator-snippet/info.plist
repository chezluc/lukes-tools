				<key>script</key>
				<string>#!/bin/bash
input="$1"
abbr=$(echo "$input" | awk '{print $1}')
expansion=$(echo "$input" | sed 's/^[^ ]* //')

/usr/bin/osascript &lt;&lt;ENDSCRIPT
tell application "Typinator"
    make new rule at end of rule set "2026.main" with properties {abbreviation:"$abbr", plain expansion:"$expansion"}
    delay 0.3
    quick search "$abbr"
end tell
ENDSCRIPT</string>
