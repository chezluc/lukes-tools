				<key>runningsubtext</key>
				<string>Creating snippet...</string>
				<key>script</key>
				<string>query="$1"
if [ -z "$query" ]; then
  echo '{"items":[{"title":"Usage: type abbr expansion text","subtitle":"First word = abbreviation, rest = expansion","valid":false}]}'
else
  abbr=$(echo "$query" | awk '{print $1}')
  expansion=$(echo "$query" | sed 's/^[^ ]* //')
  if [ "$abbr" = "$expansion" ]; then
    echo '{"items":[{"title":"Need both abbreviation and expansion","subtitle":"e.g.: type btw by the way","valid":false}]}'
  else
    echo "{\"items\":[{\"title\":\"$abbr → $expansion\",\"subtitle\":\"Press Enter to create in 2026.main\",\"arg\":\"$query\",\"valid\":true}]}"
  fi
fi</string>
				<key>scriptargtype</key>
