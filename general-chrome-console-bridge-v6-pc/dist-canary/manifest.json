{
  "manifest_version": 3,
  "name": "Chrome Console Bridge v6 (Canary)",
  "version": "0.6.0",
  "description": "Background-first agent bridge for Google Chrome Canary on http://127.0.0.1:4471.",
  "permissions": [
    "activeTab",
    "tabs",
    "debugger",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
